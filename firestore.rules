rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Validar autenticación
    function isAuthenticated() {
      return request.auth != null;
    }

    // ── Colecciones de Configuración y Seguridad ──
    match /codigos/{codigoId} {
      allow read, write: if isAuthenticated();
    }
    match /autenticados/{authId} {
      allow read, write: if isAuthenticated();
    }
    match /permisosRoles/{roleId} {
      allow read, write: if isAuthenticated();
    }

    // ── Colecciones del Sistema (Parroquias y Comunidades) ──
    match /parroquias/{parroquiaId} {
      allow read, write: if isAuthenticated();
      
      match /comunidades/{comunidadId} {
        allow read, write: if isAuthenticated();
      }
    }

    // ── Colecciones Globales de Datos ──
    match /hermanos/{hermanoId} {
      allow read, write: if isAuthenticated();
    }
    match /realidades/{realidadId} {
      allow read, write: if isAuthenticated();
    }
    match /itinerario/{itinerarioId} {
      allow read, write: if isAuthenticated();
    }
    match /temas/{temaId} {
      allow read, write: if isAuthenticated();
    }
    match /sorteos/{sorteoId} {
      allow read, write: if isAuthenticated();
    }
    match /carismas/{carismaId} {
      allow read, write: if isAuthenticated();
    }
    match /misiones/{misionId} {
      allow read, write: if isAuthenticated();
    }

    // ── Regla General de Desarrollo (Temporal) ──
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 9, 17);
    }
  }
}
